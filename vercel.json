{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npx vite build && cd .. && mkdir -p public/app && cp -r frontend/dist/* public/app/",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3.0.7",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/ready", "destination": "/api/index" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path(.*\\.(?:js|css|json|ico|png|svg|woff2?)$)", "destination": "/app/:path" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "AUTO_CREATE_SCHEMA": "false",
    "DEMO_SEED_ENABLED": "false",
    "SESSION_COOKIE_SECURE": "true",
    "HSTS_ENABLED": "true",
    "PRIMARY_UI": "react",
    "DOCS_ENABLED": "false"
  }
}
