# Federated Model Orchestration Platform — environment template
# Copy to .env and edit for your local setup.
# NEVER commit .env to version control — it is gitignored.
#
# Settings are read from the process environment first, then from the .env file at the
# REPOSITORY ROOT (the parent of platform/). An exported variable always wins.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
# Demo tier: SQLite (zero-install, default). Keep this for local work.
DATABASE_URL=sqlite:///./federated_platform.db

# Shared/MVP tier: PostgreSQL — set this in your shell or your host's secret store,
# not in a file you might commit. See DEPLOYMENT.md.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#
# WARNING: pointing DATABASE_URL at a shared/production database makes the browser UI
# write to it — an Excel ingestion committed from the workspace writes real values there.
# Schema creation and demo seeding are disabled automatically for a non-SQLite database
# (see AUTO_CREATE_SCHEMA / DEMO_SEED_ENABLED below), but ordinary use still writes.

# PostgreSQL test database. Used only by tests/test_d15_postgresql.py, which are skipped
# when it is unset. Point it at a DISPOSABLE database — those tests create and drop tables.
# The rest of the suite always runs against in-memory SQLite and refuses to start if
# DATABASE_URL is not a sqlite:// URL (see conftest.py).
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME_test

# ── Startup safety (D24) ─────────────────────────────────────────────────────
# Both default to true for SQLite and false for anything else, which is almost always
# what you want. Set them only to override that.
#
# Create missing tables at startup. Leave false for a shared database — Alembic owns
# its schema (`alembic upgrade head`).
# AUTO_CREATE_SCHEMA=false
#
# Seed the demo federation, baseline/scenario and synthetic governance records at startup.
# Leave false for a shared database so it never gains demo rows from a restart.
# DEMO_SEED_ENABLED=false

# ── Storage ──────────────────────────────────────────────────────────────────
# Demo: local filesystem. In a container, mount a volume here.
STORAGE_ROOT=./storage

# ── Public address ───────────────────────────────────────────────────────────
# The address this instance is actually reachable at. Displayed on the Start Here page.
# Leave unset until it is true — the UI reports "not configured" rather than guessing.
# PUBLIC_BASE_URL=https://your-service.example.com

# MVP: MinIO / S3 — uncomment at P1
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=platform-artifacts

# ── Airflow optional executor (D21) ──────────────────────────────────────────
# Airflow is an OPTIONAL external executor. Leave disabled for normal development/tests.
# The in-process executor is the default and never reads any of these.
# AIRFLOW_ENABLED=true
# AIRFLOW_BASE_URL=http://localhost:8080
# AIRFLOW_DAG_ID=platform_graphrun
# Authentication — a bearer token (preferred) OR basic username/password. Never commit real values.
# AIRFLOW_AUTH_TOKEN=CHANGE_ME
# AIRFLOW_USERNAME=CHANGE_ME
# AIRFLOW_PASSWORD=CHANGE_ME
# AIRFLOW_POLL_TIMEOUT_S=10
# AIRFLOW_VERIFY_TLS=true
