# Federated Model Orchestration Platform — environment template
# Copy to .env and edit for your local setup.
# Never commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
# Demo tier: SQLite (zero-install)
DATABASE_URL=sqlite:///./federated_platform.db

# MVP tier: PostgreSQL via Docker Compose — uncomment and configure at P1
# DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# ── Storage ──────────────────────────────────────────────────────────────────
# Demo: local filesystem
STORAGE_ROOT=./storage

# MVP: MinIO / S3 — uncomment at P1
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=platform-artifacts
